# =============================================================================
# FIWARE Configuration
# =============================================================================
FIWARE_BASE_URL=https://imiq-public.et.uni-magdeburg.de/api/orion
FIWARE_API_KEY=your_fiware_api_key_here

# =============================================================================
# OpenAI Configuration (GPT-5.4)
# =============================================================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# =============================================================================
# Neo4j Configuration (Neo4j Aura)
NEO4J_URI=neo4j+s://xxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# For local Neo4j (development only):
# NEO4J_URI=neo4j://127.0.0.1:7687
# NEO4J_PASSWORD=local_password

# =============================================================================
# OpenRouteService Configuration (route polyline geometry for the map only —
# routing is IMIQ, geocoding is IMIQ/Nominatim)
# =============================================================================
ORS_API_KEY=your_ors_api_key_here
ORS_BASE_URL=https://api.openrouteservice.org
# Second shape provider, raced against ORS (first answer wins) so a slow ORS
# never leaves the map with a dashed straight line. Public FOSSGIS instance by
# default (no key, fair use); point at your own Valhalla or leave empty to disable.
# VALHALLA_URL=https://valhalla1.openstreetmap.de

# =============================================================================
# IMIQ Routing API (walking / cycling / driving routes, whole Magdeburg)
# =============================================================================
IMIQ_ROUTING_URL=https://imiq-app.et.uni-magdeburg.de/api/routing

# =============================================================================
# IMIQ Geocoding API (in-house geocoder — primary fallback for place names
# the Neo4j graph doesn't know; Nominatim is the backup tier)
# =============================================================================
IMIQ_GEOCODE_URL=https://imiq-public.et.uni-magdeburg.de/api/geocode

# =============================================================================
# ElevenLabs Voice (optional — STT + TTS for the chat widget)
# Key stays SERVER-SIDE: api.py proxies /voice/*; the browser never sees it.
# Leave the key empty to disable; spoken replies are then silent (no backup
# voice by design — mic input still works via the browser's own STT).
# =============================================================================
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
# eleven_v3 (default): expressive, supports [sighs]/[laughs] audio tags used by
# speaking mode; higher latency. eleven_flash_v2_5: fastest, no audio tags.
# ELEVENLABS_TTS_MODEL=eleven_v3
# ELEVENLABS_STT_MODEL=scribe_v2
# Model for the spoken REACTION ("Ooh, the Mensa, one sec") played while the
# agent works. eleven_v3 = same voice/tone as the answers (~3 s to synthesize);
# eleven_flash_v2_5 = heard ~2 s sooner but sounds like a faster, flatter
# rendition of the voice.
ELEVENLABS_TTS_FAST_MODEL=eleven_v3
# Spoken-reaction side call (voice turns): a tiny, fast LLM call that reacts to
# what the user said while the agent looks things up. Empty model = off.
VOICE_REACTION_MODEL=gpt-5.4
VOICE_REACTION_REASONING=none
VOICE_REACTION_TIMEOUT=4
# v3 tone consistency: 0.0 Creative / 0.5 Natural (default) / 1.0 Robust.
# Raise toward 1.0 if the voice's mood jumps between sentences.
# ELEVENLABS_TTS_STABILITY=0.5

# =============================================================================
# Study mode (optional) — a fixed "you are here" for user studies run indoors
# at one known place. When both coordinates are set, every chat turn is
# anchored on that point whatever the browser sent: a route question with no
# stated origin starts there, "near me" means near there, and the widget's
# Share-location button reports it without asking the browser for GPS.
# Leave empty for real GPS. Restart api.py after changing.
# =============================================================================
# STUDY_LOCATION_LAT=52.141220
# STUDY_LOCATION_LON=11.654976
# STUDY_LOCATION_NAME="IMIQ office (Building 80), Niels-Bohr-Straße 1, Alte Neustadt"

# =============================================================================
# HuggingFace — use cached models, skip online checks
# =============================================================================
HF_HUB_OFFLINE=1

# =============================================================================
# Application Settings
# =============================================================================
MAX_CONVERSATION_HISTORY=6
HTTP_TIMEOUT=10

# Semantic cache — set false for strict multi-turn correctness
SEMANTIC_CACHE_ENABLED=false
# SEMANTIC_CACHE_THRESHOLD=0.88
# SEMANTIC_CACHE_TTL=3600
# SEMANTIC_CACHE_MAX_SIZE=500

# =============================================================================
# Magdeburg Coordinates (for geocoding focus)
# =============================================================================
MAGDEBURG_LAT=52.1205
MAGDEBURG_LON=11.6276

# =============================================================================
# Agent 
# =============================================================================
SINGLE_AGENT_MODEL=gpt-5.4
AGENT_TIMEOUT=90
AGENT_VERBOSE_LOGGING=false
